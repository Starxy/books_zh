%% CHAPTER STYLE
\def\@makechapterhead#1{
  {\parindent \z@ \raggedright \normalfont
   \ifnum \c@secnumdepth >\m@ne
      \if@mainmatter
        \Large\upshape\bfseries 第\thechapter 章
        \par\nobreak
        \vskip 20\p@
      \fi
    \fi
    \interlinepenalty\@M
    \flushleft\parbox{\textwidth}{\raggedright\huge #1}
     \par\nobreak
     \vskip 15pt
     \hrule height 0.4pt
  }}
\def\@makeschapterhead#1{
  {\parindent \z@ \raggedright \normalfont
    \interlinepenalty\@M
      \huge  #1
