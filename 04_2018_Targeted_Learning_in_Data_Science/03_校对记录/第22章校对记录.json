  "new_terms": [
    {
      "en": "sequential randomized controlled trial",
      "zh": "序贯随机对照试验",
      "note": "本章的sequential RCT；两个时间点依次随机化处理。"
    },
    {
      "en": "exceptional law",
      "zh": "例外分布",
      "note": "与术语表已有nonexceptional law=非例外分布对应；law指概率分布。"
    },
    {
      "en": "data-adaptive parameter",
      "zh": "数据自适应参数",
      "note": "与已有data-adaptive target parameter统一；本章目标随训练样本估计规则而变。"
    },
    {
      "en": "individualized treatment rule",
      "zh": "个体化处理规则",
      "note": "根据可获得历史或给定协变量子集分配处理。"
    },
    {
      "en": "causally optimal rule",
      "zh": "因果最优规则",
      "note": "SCM反事实分布下最大化均值的规则，与未假定识别时的统计最优规则区分。"
    },
    {
      "en": "Q-learning",
      "zh": "Q学习",
      "note": "本章逐时点回归并求最优规则的方法；正文首现保留英文。"
    },
    {
      "en": "nonregularity",
      "zh": "非正则性",
      "note": "本章亦将irregularity译为非正则性；指估计量的统计正则性。"
    },
    {
      "en": "structural nested mean model",
      "zh": "结构嵌套均值模型",
      "note": "本章为最优动态处理的处理增益函数设定模型。"
    },
    {
      "en": "m out of n bootstrap",
      "zh": "从n个观测中抽取m个观测的自助法",
      "note": "本章保留m与n的区别，未把它替换为普通n取自n自助法。"
    }
  ],
